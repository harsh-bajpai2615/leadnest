# Copy to .env and fill in.

# Postgres connection string. Local dev or a free hosted DB (Neon, Prisma
# Postgres, Supabase, Vercel Postgres all work — it just needs to be Postgres).
DATABASE_URL="postgresql://user:password@host:5432/leadnest?schema=public"

# Secret used to sign session JWTs. Must be at least 16 chars.
# Generate one with:  openssl rand -hex 32
AUTH_SECRET="change-me-to-a-long-random-string"
